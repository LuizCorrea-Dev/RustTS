{
  "name": "rustts-lang",
  "displayName": "RustTS (.rts) — Deterministic Systems & Engine Language",
  "description": "Official syntax highlighting, file icons, capability colorization, and snippets for RustTS (.rts) v2.1.0-rts",
  "version": "2.1.0",
  "publisher": "Rootszera",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "icon": "icons/rustts.png",
  "contributes": {
    "languages": [
      {
        "id": "rustts",
        "aliases": [
          "RustTS",
          "rustts",
          "rts"
        ],
        "extensions": [
          ".rts"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/rustts.png",
          "dark": "./icons/rustts.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "rustts",
        "scopeName": "source.rustts",
        "path": "./syntaxes/rustts.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rustts",
        "path": "./snippets/rustts.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "entity.name.function.decorator.rustts",
            "settings": {
              "foreground": "#FFD700",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "keyword.other.capability.rustts",
            "settings": {
              "foreground": "#FF5555",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "support.type.capability.rustts",
            "settings": {
              "foreground": "#FF79C6",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "keyword.operator.try.rustts",
            "settings": {
              "foreground": "#FF5555",
              "fontStyle": "bold"
            }
          }
        ]
      }
    }
  }
}