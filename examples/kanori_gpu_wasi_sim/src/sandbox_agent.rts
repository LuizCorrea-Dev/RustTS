module sandbox.kanori_agent;

@sealed_sig
pub fn decidir_evacuacao_agente(
    dose_inicial: float,
    incremento_por_tick: float,
    ticks_simulacao: int
) -> int {
    let acumulado: float = dose_inicial;
    let passo: int = 0;
    while passo < ticks_simulacao {
        acumulado = acumulado + incremento_por_tick;
        passo = passo + 1;
        if acumulado > 300.0 {
            return 1;
        }
    }
    return 0;
}
