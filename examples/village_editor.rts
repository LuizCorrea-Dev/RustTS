) {
    mesh::mesh_write_box(verts, inds, v_off + 0,  i_off + 0,  vec3::vec3_new(0.0, -0.65, 0.0), vec3::vec3_new(1.0, 0.35, 0.45), col);
    mesh::mesh_write_box(verts, inds, v_off + 24, i_off + 36, vec3::vec3_new(0.0, 0.25, 0.0),  vec3::vec3_new(1.0, 0.65, 0.20), col);
}

// Malha 5: Casa / Galpao com Vao de Porta (Apenas Paredes e Piso = 144 vertices, 216 indices)
@sealed_sig
pub fn mesh_write_house_shell(
    verts: cap MutSlice<mesh::Vertex3D>,
    inds: cap MutSlice<u32>,
    v_off: usize,
    i_off: usize,
    col: vec4::Vec4
) {
    // Parede Traseira (-Z), Parede Esquerda (-X), Parede Direita (+X)
    mesh::mesh_write_box(verts, inds, v_off + 0,   i_off + 0,   vec3::vec3_new( 0.0,  0.0, -0.90), vec3::vec3_new(1.00, 0.70, 0.10), col);
    mesh::mesh_write_box(verts, inds, v_off + 24,  i_off + 36,  vec3::vec3_new(-0.90, 0.0,  0.0),  vec3::vec3_new(0.10, 0.70, 0.80), col);
    mesh::mesh_write_box(verts, inds, v_off + 48,  i_off + 72,  vec3::vec3_new( 0.90, 0.0,  0.0),  vec3::vec3_new(0.10, 0.70, 0.80), col);
    // Frente com abertura de porta central (Ombreira Esq + Ombreira Dir)
    mesh::mesh_write_box(verts, inds, v_off + 72,  i_off + 108, vec3::vec3_new(-0.62, 0.0,  0.90), vec3::vec3_new(0.38, 0.70, 0.10), col);
    mesh::mesh_write_box(verts, inds, v_off + 96,  i_off + 144, vec3::vec3_new( 0.62, 0.0,  0.90), vec3::vec3_new(0.38, 0.70, 0.10), col);
    // Laje de piso interno
    mesh::mesh_write_box(verts, inds, v_off + 120, i_off + 180, vec3::vec3_new( 0.0, -0.65, 0.0), vec3::vec3_new(0.92, 0.08, 0.82), vec4::vec4_new(0.35, 0.35, 0.38, 1.0));
}

