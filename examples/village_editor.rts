@sealed_sig
pub fn catalog_mesh_id_from_hash(prefab_hash: u64) -> usize {
    if prefab_hash <= 7 {
        return prefab_hash as usize;
    }
    return 0;
}

@sealed_sig
pub fn mesh_set_vertex(
    verts: cap MutSlice<mesh::Vertex3D>,
    idx: usize,
    px: float,
    py: float,
    pz: float,
    nx: float,
    ny: float,
    nz: float,
    u: float,
    v: float,
    col: vec4::Vec4
) {
    verts[idx] = mesh::Vertex3D {
        pos_u: vec4::vec4_new(px, py, pz, u),
        norm_v: vec4::vec4_new(nx, ny, nz, v),
        color: col,
    };
}

@sealed_sig
pub fn mesh_push_quad(
    verts: cap MutSlice<mesh::Vertex3D>,
    inds: cap MutSlice<u32>,
    v_base: usize,
    i_base: usize,
    p0: vec3::Vec3,
    p1: vec3::Vec3,
    p2: vec3::Vec3,
    p3: vec3::Vec3,
    n: vec3::Vec3,
    col: vec4::Vec4
) {
    mesh_set_vertex(verts, v_base + 0, p0.x, p0.y, p0.z, n.x, n.y, n.z, 0.0, 0.0, col);
    mesh_set_vertex(verts, v_base + 1, p1.x, p1.y, p1.z, n.x, n.y, n.z, 1.0, 0.0, col);
    mesh_set_vertex(verts, v_base + 2, p2.x, p2.y, p2.z, n.x, n.y, n.z, 1.0, 1.0, col);
    mesh_set_vertex(verts, v_base + 3, p3.x, p3.y, p3.z, n.x, n.y, n.z, 0.0, 1.0, col);

    let vb = v_base as u32;
    inds[i_base + 0] = vb + 0;
    inds[i_base + 1] = vb + 1;
    inds[i_base + 2] = vb + 2;
    inds[i_base + 3] = vb + 0;
    inds[i_base + 4] = vb + 2;
    inds[i_base + 5] = vb + 3;
}

@sealed_sig
pub fn mesh_push_tri(
    verts: cap MutSlice<mesh::Vertex3D>,
    inds: cap MutSlice<u32>,
    v_base: usize,
    i_base: usize,
    p0: vec3::Vec3,
    p1: vec3::Vec3,
    p2: vec3::Vec3,
    n: vec3::Vec3,
    col: vec4::Vec4
) {
    mesh_set_vertex(verts, v_base + 0, p0.x, p0.y, p0.z, n.x, n.y, n.z, 0.0, 0.0, col);
    mesh_set_vertex(verts, v_base + 1, p1.x, p1.y, p1.z, n.x, n.y, n.z, 1.0, 0.0, col);
    mesh_set_vertex(verts, v_base + 2, p2.x, p2.y, p2.z, n.x, n.y, n.z, 0.5, 1.0, col);

    let vb = v_base as u32;
    inds[i_base + 0] = vb + 0;
    inds[i_base + 1] = vb + 1;
    inds[i_base + 2] = vb + 2;
}

// Malha 1: Telhado Duas Aguas (18 vertices, 24 indices)
@sealed_sig
pub fn mesh_write_gable_roof(
    verts: cap MutSlice<mesh::Vertex3D>,
    inds: cap MutSlice<u32>,
    v_off: usize,
    i_off: usize,
    col: vec4::Vec4
) {
    // Base inferior
    mesh_push_quad(
        verts, inds, v_off + 0, i_off + 0,
        vec3::vec3_new(-1.0, -1.0, -1.0), vec3::vec3_new(1.0, -1.0, -1.0),
        vec3::vec3_new(1.0, -1.0, 1.0), vec3::vec3_new(-1.0, -1.0, 1.0),
        vec3::vec3_new(0.0, -1.0, 0.0), col
    );
    // Agua esquerda
    mesh_push_quad(
        verts, inds, v_off + 4, i_off + 6,
        vec3::vec3_new(-1.0, -1.0, 1.0), vec3::vec3_new(0.0, 1.0, 1.0),
        vec3::vec3_new(0.0, 1.0, -1.0), vec3::vec3_new(-1.0, -1.0, -1.0),
        vec3::vec3_new(-0.894427, 0.447214, 0.0), col
    );
    // Agua direita
    mesh_push_quad(
        verts, inds, v_off + 8, i_off + 12,
        vec3::vec3_new(0.0, 1.0, 1.0), vec3::vec3_new(1.0, -1.0, 1.0),
        vec3::vec3_new(1.0, -1.0, -1.0), vec3::vec3_new(0.0, 1.0, -1.0),
        vec3::vec3_new(0.894427, 0.447214, 0.0), col
    );
    // Empena frontal (Z+)
    mesh_push_tri(
        verts, inds, v_off + 12, i_off + 18,
        vec3::vec3_new(-1.0, -1.0, 1.0), vec3::vec3_new(1.0, -1.0, 1.0), vec3::vec3_new(0.0, 1.0, 1.0),
        vec3::vec3_new(0.0, 0.0, 1.0), col
    );
    // Empena traseira (Z-)
    mesh_push_tri(
        verts, inds, v_off + 15, i_off + 21,
        vec3::vec3_new(1.0, -1.0, -1.0), vec3::vec3_new(-1.0, -1.0, -1.0), vec3::vec3_new(0.0, 1.0, -1.0),
        vec3::vec3_new(0.0, 0.0, -1.0), col
    );
}

// Malha 2: Torre de Vigia (6 caixas = 144 vertices, 216 indices)
@sealed_sig
pub fn mesh_write_watchtower(
    verts: cap MutSlice<mesh::Vertex3D>,
    inds: cap MutSlice<u32>,
    v_off: usize,
    i_off: usize,
    col: vec4::Vec4
) {
    let leg_half = vec3::vec3_new(0.12, 0.65, 0.12);
    mesh::mesh_write_box(verts, inds, v_off + 0,   i_off + 0,   vec3::vec3_new(-0.75, -0.35, -0.75), leg_half, col);
    mesh::mesh_write_box(verts, inds, v_off + 24,  i_off + 36,  vec3::vec3_new(0.75, -0.35, -0.75),  leg_half, col);
    mesh::mesh_write_box(verts, inds, v_off + 48,  i_off + 72,  vec3::vec3_new(-0.75, -0.35, 0.75),  leg_half, col);
    mesh::mesh_write_box(verts, inds, v_off + 72,  i_off + 108, vec3::vec3_new(0.75, -0.35, 0.75),   leg_half, col);
    mesh::mesh_write_box(verts, inds, v_off + 96,  i_off + 144, vec3::vec3_new(0.0, 0.35, 0.0), vec3::vec3_new(0.95, 0.10, 0.95), col);
    mesh::mesh_write_box(verts, inds, v_off + 120, i_off + 180, vec3::vec3_new(0.0, 0.88, 0.0), vec3::vec3_new(0.95, 0.12, 0.95), col);
}

@sealed_sig
pub fn mesh_write_pyramid_tier(
    verts: cap MutSlice<mesh::Vertex3D>,
    inds: cap MutSlice<u32>,
    v_off: usize,
    i_off: usize,
    y_bot: float,
    y_top: float,
    half_w: float,
    col: vec4::Vec4
) {
    let apex = vec3::vec3_new(0.0, y_top, 0.0);
    let c0 = vec3::vec3_new(-half_w, y_bot, half_w);
    let c1 = vec3::vec3_new(half_w, y_bot, half_w);
    let c2 = vec3::vec3_new(half_w, y_bot, -half_w);
    let c3 = vec3::vec3_new(-half_w, y_bot, -half_w);

    mesh_push_quad(verts, inds, v_off + 0, i_off + 0, c3, c2, c1, c0, vec3::vec3_new(0.0, -1.0, 0.0), col);
    mesh_push_tri(verts, inds, v_off + 4,  i_off + 6,  c0, c1, apex, vec3::vec3_new(0.0, 0.5, 0.866), col);
    mesh_push_tri(verts, inds, v_off + 7,  i_off + 9,  c1, c2, apex, vec3::vec3_new(0.866, 0.5, 0.0), col);
    mesh_push_tri(verts, inds, v_off + 10, i_off + 12, c2, c3, apex, vec3::vec3_new(0.0, 0.5, -0.866), col);
    mesh_push_tri(verts, inds, v_off + 13, i_off + 15, c3, c0, apex, vec3::vec3_new(-0.866, 0.5, 0.0), col);
}

// Malha 3: Pinheiro (Tronco + 2 copas piramidais = 56 vertices, 72 indices)
@sealed_sig
pub fn mesh_write_pine_tree(
    verts: cap MutSlice<mesh::Vertex3D>,
    inds: cap MutSlice<u32>,
    v_off: usize,
    i_off: usize
) {
    let trunk_col = vec4::vec4_new(0.55, 0.38, 0.24, 1.0);
    let leaf_bot  = vec4::vec4_new(0.45, 0.78, 0.42, 1.0);
    let leaf_top  = vec4::vec4_new(0.52, 0.86, 0.48, 1.0);
    mesh::mesh_write_box(verts, inds, v_off + 0, i_off + 0, vec3::vec3_new(0.0, -0.60, 0.0), vec3::vec3_new(0.16, 0.40, 0.16), trunk_col);
    mesh_write_pyramid_tier(verts, inds, v_off + 24, i_off + 36, -0.25, 0.55, 0.95, leaf_bot);
    mesh_write_pyramid_tier(verts, inds, v_off + 40, i_off + 54, 0.25, 1.0, 0.65, leaf_top);
}

// Malha 4: Barreira Jersey de Concreto (2 caixas = 48 vertices, 72 indices)
@sealed_sig
pub fn mesh_write_jersey_barrier(
    verts: cap MutSlice<mesh::Vertex3D>,
    inds: cap MutSlice<u32>,
    v_off: usize,
    i_off: usize,
