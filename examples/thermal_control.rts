module drone.thermal_control;
import core.hardware;
import core.math;

struct SensorConfig {
    target_temp_celsius: f32,
    max_pwm_duty: u8,
}

enum HardwareFault {
    I2CTimeout(u8),
    SensorDisconnected,
    OverheatCritical(f32),
}

// CASO 1 (VÁLIDO): A assinatura declara explicitamente todas as capacidades físicas necessárias.
pub fn regulate_motor_cooling(
    config: SensorConfig,
    i2c: cap I2CBus<0x48>,
    pwm: cap PWMPin<4>,
    clock: cap MonotonicClock
) -> Result<f32, HardwareFault> {
    let raw_data: u16 = i2c.read_register_u16(0x00)
        .map_err(|_| HardwareFault::I2CTimeout(0x48))?;

    if raw_data == 0xFFFF {
        return Err(HardwareFault::SensorDisconnected);
    }

    let current_temp: f32 = (raw_data as f32) * 0.0625;

    // VIOLAÇÃO SIMULADA NA LINHA 28 (quando descomentada, gera RTS-E0402):
    // NetworkSocket::send("192.168.1.100:9000", current_temp);

    if current_temp >= 105.0 {
        pwm.set_duty(100);
        return Err(HardwareFault::OverheatCritical(current_temp));
    }

    if current_temp > config.target_temp_celsius {
        let delta: f32 = current_temp - config.target_temp_celsius;
        let duty: u8 = math::clamp(delta * 5.0, 20.0, config.max_pwm_duty as f32) as u8;
        pwm.set_duty(duty);
    } else {
        pwm.set_duty(0);
    }

    return Ok(current_temp);
}

// CASO 2 (VÁLIDO — v0.9.0-rts): Pattern Matching Exaustivo sobre Tagged Union com Desestruturação de Payload
pub fn classify_fault_severity(fault: HardwareFault) -> u8 {
    match fault {
        HardwareFault::I2CTimeout(addr) => {
            if addr == 0x48 {
                return 2;
            }
            return 1;
        },
        HardwareFault::SensorDisconnected => {
            return 3;
        },
        HardwareFault::OverheatCritical(temp) => {
            if temp >= 110.0 {
                return 10;
            }
            return 5;
        },
    }
}

// CASO 3 (VÁLIDO — v1.0.0-rts): Loop Determinístico `while` + `match` Exaustivo sobre `Result<f32, HardwareFault>`
pub fn supervise_cooling_cycle(
    reading: Result<f32, HardwareFault>,
    max_retries: u8
) -> u8 {
    let mut retries: u8 = 0;
    while retries < max_retries {
        retries = retries + 1;
    }
    match reading {
        Ok(temp) => {
            if temp > 60.0 {
                return 1;
            }
            return 0;
        },
        Err(fault) => {
            return self::classify_fault_severity(fault) + retries;
        },
    }
}



